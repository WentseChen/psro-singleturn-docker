# syntax=docker/dockerfile:1
# The same CUDA 12.4 / torch 2.6 / vLLM 0.8.2 base used by our Modal trainer.
FROM vllm/vllm-openai:v0.8.2@sha256:61732e5aae863dc2e1df4c4a3e45a95d55b3991917b3bedc8bf1da5e077a4eb4

USER root
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    MAX_JOBS=4
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential libaio-dev libcairo2-dev pkg-config procps util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf "$(command -v python3)" /usr/local/bin/python

COPY docker/requirements-llama8b.txt /opt/requirements-llama8b.txt
RUN python -m pip install --no-cache-dir -r /opt/requirements-llama8b.txt \
    && python -m pip install --no-cache-dir --no-build-isolation flash-attn==2.7.4.post1

RUN git init /opt/selfplay-redteaming \
    && git -C /opt/selfplay-redteaming remote add origin https://github.com/mickelliu/selfplay-redteaming.git \
    && git -C /opt/selfplay-redteaming fetch --depth=1 origin 0c56e503e8ae1b1b0fcd2214c92ea31fef1cb123 \
    && git -C /opt/selfplay-redteaming checkout --detach FETCH_HEAD \
    && python -m zipfile -e /opt/selfplay-redteaming/red_team/data/data.zip /opt/selfplay-redteaming/red_team/data \
    && rm -rf /opt/selfplay-redteaming/.git

WORKDIR /opt/SafeSelfPlay
COPY *.py ./
COPY roll/ ./roll/
COPY _modal_patches/ ./_modal_patches/
COPY scripts/slurm/ ./scripts/slurm/
COPY data/safety_selfplay/ ./data/safety_selfplay/
COPY docker/ ./docker/
COPY README.md EXPERIMENTS.md TOPIC_JUDGE_AND_SHARED_REWARD.md ./

# Build provenance. The repo is COPYed in, not mounted, so a container's code is
# frozen at build time and a stale image is otherwise indistinguishable from a
# fresh one -- it just silently reintroduces whatever was fixed since. Stamping
# the commit lets `check` say which code is actually inside.
ARG SSP_GIT_SHA=unknown
ARG SSP_BUILD_DATE=unknown
LABEL org.opencontainers.image.source="https://github.com/xudongwu-0/SafeSelfPlay" \
      org.opencontainers.image.revision="$SSP_GIT_SHA" \
      org.opencontainers.image.created="$SSP_BUILD_DATE" \
      org.opencontainers.image.title="SafeSelfPlay Llama-3.1-8B role-LoRA (4xH200)"
RUN printf 'git_sha=%s\nbuild_date=%s\n' "$SSP_GIT_SHA" "$SSP_BUILD_DATE" \
    > /opt/SafeSelfPlay/BUILD_INFO

# Patched code and SFT data are part of the image. Only model caches and run
# artifacts belong on the persistent /workspace mount; startup never repatches.
ENV SSP_ROOT=/workspace \
    SSP_REPO=/opt/SafeSelfPlay \
    SSP_UPSTREAM_SRC=/opt/selfplay-redteaming \
    SSP_WORK=/opt/selfplay-work \
    SSP_SFT_DIR=/opt/selfplay-sft \
    SSP_HF_HOME=/workspace/hf \
    HF_HOME=/workspace/hf \
    PYTHONPATH=/opt/selfplay-work:/opt/SafeSelfPlay \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_DISABLE_XET=1 \
    NCCL_CUMEM_ENABLE=0 \
    VLLM_ENABLE_V1_MULTIPROCESSING=0 \
    TORCH_EXTENSIONS_DIR=/workspace/torch_extensions \
    WANDB_DIR=/workspace/wandb \
    OFFTOPIC_ENABLE=0 \
    GAME_REWARD_MODE=legacy \
    ATTACKER_INVALID_MOVE=1 \
    TOPIC_PENALTY=2 \
    TOPIC_JUDGE_BACKEND=local \
    TOPIC_API_PROVIDER=anthropic \
    TOPIC_API_BASE_URL=https://api.anthropic.com \
    TOPIC_API_MODEL=claude-opus-5 \
    INIT_KL_COEF=0 \
    LADDER_EARLY_STOP=1 \
    RACE_CELLS=1 \
    CELL_STREAMING=0 \
    WANDB_ENTITY=2373025856w-the-university-of-hong-kong \
    WANDB_PROJECT=self-play \
    WANDB_GROUP=upstream-selfredteam-role-lora-v2 \
    PSRO_MIDRUN_RESUME=0

RUN mkdir -p "$SSP_SFT_DIR" \
    && python scripts/slurm/prepare_sources.py \
    && python scripts/slurm/prepare_sft_data.py \
    && python scripts/slurm/patch_defender_cot.py \
    && python scripts/slurm/patch_offtopic_labels.py \
    && python -m pip install --no-deps --no-build-isolation -e "$SSP_WORK" \
    && python -m pip check \
    && python -c "from llamafactory.hparams import FinetuningArguments, ModelArguments; from llamafactory.model.adapter import init_adapter" \
    && python -m pip freeze > /opt/runtime-packages.txt

ENTRYPOINT ["python", "/opt/SafeSelfPlay/docker/llama8b_entrypoint.py"]
CMD ["--help"]
