# psro.env -- EVERY knob explicit, no inherited defaults. Paths are the in-container layout
# (the image reproduces the exact absolute paths the conda envs are pinned to).
# Single-turn Cold PSRO, 8 generations (iterations). Reward v8-table-r2-seedskip-faithful0.8.

# --- layout (reproduced inside the container; do not change) ---
export WORKSPACE=/zfsauton/scratch/wentsec/coldpsro_slurm
export SSP_REPO=/zfsauton/scratch/wentsec/ssp_v10xm_g2
export SSP_WORK=/zfsauton/scratch/wentsec/coldpsro_slurm/work_v9zp_g2
export SSP_PYTHON=/zfsauton/scratch/wentsec/envs/srt/bin/python
export ROLLOUT_ENV=/scratch/wentsec/envs/vllm30
export SSP_HF_HOME=/zfsauton/scratch/wentsec/hf_srt
export SSP_SFT_DIR=/zfsauton/scratch/wentsec/sft_data
export ROLE_PHASE_SCRIPT=/zfsauton/scratch/wentsec/coldpsro_slurm/async_prof/role_phase_v9sb_flame.sh

# --- models (ALL off-the-shelf open-source; NO checkpoints from us) ---
# Base policy = the public abliterated Llama-3.1-8B (same model used as the topic-judge base).
# Cold PSRO starts every oracle from this base with a fresh LoRA; nothing of ours is shipped.
export BASE_MODEL_PATH=/zfsauton/scratch/wentsec/hf_srt/hub/models--mlabonne--Meta-Llama-3.1-8B-Instruct-abliterated/snapshots/368c8ed94ce4c986e7b9ca5c159651ef753908ce
export JUDGE_MODEL_PATH=/zfsauton/scratch/wentsec/hf_srt/hub/models--allenai--wildguard/snapshots/cbba4823f3e8020e5a74a5e29bf85072def6f2ff
export TOPIC_JUDGE_BASE_MODEL=/zfsauton/scratch/wentsec/hf_srt/hub/models--mlabonne--Meta-Llama-3.1-8B-Instruct-abliterated/snapshots/368c8ed94ce4c986e7b9ca5c159651ef753908ce
export FAITHFUL_JUDGE_MODEL_PATH=/zfsauton/scratch/wentsec/hf_srt/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
export ONEJOB_SHARED_BASE=0   # serve the abliterated base directly; per-oracle adapters are LoRA r64
export LORA_RANK=64

# --- results sharing (fill these in; see README) ---
# wandb: set WANDB_API_KEY (and optionally WANDB_ENTITY) so training metrics are logged + shareable.
export WANDB_PROJECT=${WANDB_PROJECT:-coldpsro-singleturn-baseline}
export WANDB_MODE=${WANDB_MODE:-online}
# HuggingFace: set HF_PUSH_REPO=<your-org>/<repo> and HF_TOKEN to auto-push LoRA adapters (see push_checkpoints.sh).
export HF_PUSH_REPO=${HF_PUSH_REPO:-}

# --- PSRO size: 8 iterations ---
export GPUS=8
export GENERATIONS=8          # PSRO generations = iterations (A0..A8 / D0..D8)
export STEPS_PER_ROLE=600
export MATRIX_EPISODES=4096

# --- algorithm (verbatim from the live g2full contract; single-turn) ---
export GAME_REWARD_MODE=v7 V8_TABLE=1 V8_FAITHFUL_JUDGE=1 V8_FAITHFUL_THR=0.8
export V8_GATE_FULFIL_OVERLAP=1 V8_JUDGE_OVERLAP=1 V8_FULFIL_COLAUNCH=1
export V7_SEED_SKIP=1 V7_SEED_SKIP_MAX_PASS=0.5 V7_SEED_SKIP_MIN_VISITS=1
export DROP_MASK=1 BENIGN_AS_HARMFUL_FRAC=0.7 FORCE_DEFENDER_COT_FROZEN=1
export GROUP_SIZE=4 GENERATIONS_PER_PROMPT=8 GROUP_BASELINE=mean GROUP_SHARE_ATTACK=1 NO_ADV_STD_NORM=1
export ROLLOUT_BATCH=64 TRAIN_BATCH=128
export ATTACKER_LR=5e-6 DEFENDER_LR=1e-5
export INIT_KL_COEF=0.001 KL_COEF_MAX=2.0 KL_COEF_MIN=0.0001 KL_EXACT=1 KL_HORIZON=128 KL_REF=adapter_off
export KL_TARGET=0.15 KL_TARGET_ATTACKER=0.50 KL_TARGET_DEFENDER=0.30
export DUAL_CLIP_C=3 ASYNC_TIS_CAP=2 ASYNC_SEQ_REJECT=0.5,2 ASYNC_TOKEN_MASK=0.5,2
export ASYNC_STALE_K=3 ASYNC_STALE_K_DEFENDER=4 ENGINE_OLD_LOGP=0
export PSRO_UNIFORM_MIX=0.5
export ATK_EARLY_STOP=1 ATK_MIN_STEP=200 ATK_PATIENCE=5 ATK_MIN_DELTA=0.01 ATK_PLATEAU_FLOOR=0.05 ATK_CEILING_MAX=0.05 LADDER_EARLY_STOP=1
export FORMAT_GRAMMAR=1 FORMAT_RESCUE_RESERVE=256 SFT_STOP=0
export TRAINING_SEED=8889

# --- system / serving (8xH200; one engine per card, shared abliterated base) ---
export ONEJOB_SERVER_UTILS=0.68,0.68,0.68,0.92,0.92,0.92,0.92,0.92
export ONEJOB_JUDGE_GPUS=0,1,2 ONEJOB_TOPIC_GPU=7 ONEJOB_FAITHFUL_JUDGE_GPU=3
export ONEJOB_TRAIN_CARDS_ATTACKER=6,7 ONEJOB_TRAIN_CARDS_DEFENDER=4,5,6,7
export ONEJOB_MAX_LORAS=16 ONEJOB_MAX_CPU_LORAS=16 ONEJOB_CELL_WG_REPLICAS=1
export MICRO_TRAIN_ATTACKER=16 MICRO_TRAIN_DEFENDER=16
export GC_FLAGS_ATTACKER='' GC_FLAGS_DEFENDER='--gradient_checkpointing' GC_LAYER_EVERY_DEFENDER=2
export USE_LIGER_ATTACKER=1 USE_LIGER_DEFENDER=''
export REF_PREFETCH=1 V6_CONCURRENCY=64 V6_REF_MAX_TOKENS=256 TOPIC_API_TIMEOUT=300
